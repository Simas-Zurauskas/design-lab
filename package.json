  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "parcel": "^2.15.4",
    "posthtml-include": "^2.0.1",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "lucide": "^1.28.0"
  }
}
